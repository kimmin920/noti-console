# Environment
# Use one Dokploy app per environment:
# - dev:  APP_ENV=development, APP_DOMAIN=noti-dev.vizuo.work
# - prod: APP_ENV=production,  APP_DOMAIN=noti.vizuo.work
APP_ENV=development
APP_DOMAIN=noti-dev.vizuo.work
NEXT_PUBLIC_APP_URL=https://noti-dev.vizuo.work

# Clerk auth. Use separate Clerk applications for dev and prod.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Development-only CLI/API fallback. Keep false in Dokploy.
RELAY_DEV_AUTH_HEADER_ENABLED=false

# Supabase Postgres. Use separate Supabase projects for dev and prod.
# Use the session pooler on port 5432 for Dokploy unless direct IPv6 is confirmed.
# Direct URLs are IPv6-only on many Supabase projects and may fail inside Docker.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# NHN direct product APIs. Secrets must only be read on the server.
NHN_SMS_API_BASE_URL=https://sms.api.nhncloudservice.com
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_SMS_WEBHOOK_SIGNATURE=
NHN_KAKAO_BIZMESSAGE_API_BASE_URL=https://kakaotalk-bizmessage.api.nhncloudservice.com
NHN_KAKAO_BIZMESSAGE_APP_KEY=
NHN_KAKAO_BIZMESSAGE_SECRET_KEY=
NHN_KAKAO_BIZMESSAGE_WEBHOOK_SIGNATURE=

# PUBL Open API webhook signature secret.
PUBL_OPEN_API_WEBHOOK_SECRET=

# Private sender-resource evidence storage. Use separate buckets for dev and prod.
EVIDENCE_STORAGE_DRIVER=r2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_EVIDENCE_BUCKET=
EVIDENCE_STORAGE_LOCAL_DIR=/private/tmp/noti-console-evidence
EVIDENCE_CLEANUP_ENABLED=true
EVIDENCE_CLEANUP_LIMIT=100

# Background worker.
WORKER_INTERVAL_MS=60000
SMS_BULK_SEND_WORKER_ENABLED=true
SMS_BULK_SEND_MAX_BATCHES_PER_TICK=100
SMS_BULK_PAYLOAD_CLEANUP_LIMIT=100
MESSAGE_RESULT_CORRECTION_WORKER_ENABLED=true
MESSAGE_RESULT_CORRECTION_LIMIT=20
MESSAGE_LOG_ARCHIVE_CLEANUP_LIMIT=100
MESSAGE_LOG_PURGE_CLEANUP_LIMIT=100
