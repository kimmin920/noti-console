# App
APP_DOMAIN=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth. Enable Google login in the Clerk Dashboard social connection settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional local CLI/API smoke fallback. Ignored in production.
RELAY_DEV_AUTH_HEADER_ENABLED=false

# Postgres
POSTGRES_DB=messaging_app
POSTGRES_USER=messaging
POSTGRES_PASSWORD=messaging
DATABASE_URL=postgres://messaging:messaging@postgres:5432/messaging_app
DATABASE_MIGRATION_URL=

# NHN direct product APIs. Secrets must only be read on the server.
NHN_SMS_API_BASE_URL=https://sms.api.nhncloudservice.com
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_KAKAO_BIZMESSAGE_API_BASE_URL=https://kakaotalk-bizmessage.api.nhncloudservice.com
NHN_KAKAO_BIZMESSAGE_APP_KEY=
NHN_KAKAO_BIZMESSAGE_SECRET_KEY=

# Private sender-resource evidence storage. Keep these server-only.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_EVIDENCE_BUCKET=
EVIDENCE_STORAGE_DRIVER=
EVIDENCE_STORAGE_LOCAL_DIR=/private/tmp/messaging-app-evidence
EVIDENCE_CLEANUP_ENABLED=true
EVIDENCE_CLEANUP_LIMIT=100
WORKER_INTERVAL_MS=60000
