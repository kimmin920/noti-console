{
  "name": "messaging-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "test:server": "vitest run --config vitest.config.mjs",
    "test:domain-detail-contract": "node scripts/check_domain_detail_contract.mjs",
    "test:sms-sender-application-flow-contract": "node scripts/check_sms_sender_application_flow_contract.mjs",
    "test:nhn-brand-message-contract": "node scripts/check_nhn_brand_message_contract.mjs",
    "test:brand-message-bizgo-parity": "node scripts/check_brand_message_bizgo_parity.mjs",
    "test:brand-message-bizgo-parity:resolved": "node scripts/check_brand_message_bizgo_parity.mjs --enforce-resolution",
    "audit:brand-message-bizgo-parity": "node scripts/check_brand_message_bizgo_parity.mjs --report",
    "test:template-list-contract": "node scripts/check_template_list_contract.mjs",
    "test:brand-message-playground-contract": "node scripts/check_brand_message_playground_contract.mjs",
    "test:automation-rule-management-contract": "node scripts/check_automation_rule_management_contract.mjs",
    "test:automation-template-compatibility-contract": "node scripts/check_automation_template_compatibility_contract.mjs",
    "test:automation-builder-message-flow-contract": "node scripts/check_automation_builder_message_flow_contract.mjs",
    "test:automation-unified-builder-no-readiness-contract": "node scripts/check_automation_unified_builder_no_readiness_contract.mjs",
    "test:automation-template-modal-selection-contract": "node scripts/check_automation_template_modal_selection_contract.mjs",
    "test:automation-open-api-contract": "node scripts/check_automation_open_api_contract.mjs",
    "test:automation-open-api-code-extract-contract": "node scripts/check_automation_open_api_code_extract_contract.mjs",
    "test:message-log-provenance-contract": "node scripts/check_message_log_provenance_contract.mjs",
    "test:brand-message-template-start-flow-contract": "node scripts/check_brand_message_template_start_flow_contract.mjs",
    "test:brand-template-selection-action-menu-contract": "node scripts/check_brand_template_selection_action_menu_contract.mjs",
    "test:publ-event-contract-inspector-contract": "node scripts/check_publ_event_contract_inspector_contract.mjs",
    "test:publ-event-editor-contract": "node scripts/check_publ_event_editor_contract.mjs",
    "test:publ-event-sample-parity-contract": "node scripts/check_publ_event_sample_parity_contract.mjs",
    "test:resend-onboarding-component-port-contract": "node scripts/check_resend_onboarding_component_port_contract.mjs",
    "test:message-log-detail-resend-content-contract": "node scripts/check_message_log_detail_resend_content_contract.mjs",
    "test:message-result-status-contract": "node scripts/check_message_result_status_contract.mjs",
    "test:sms-sender-duplicate-guard-contract": "node scripts/check_sms_sender_duplicate_guard_contract.mjs",
    "test:template-create-contract": "node scripts/check_template_create_contract.mjs",
    "test:settings-usage-contract": "node scripts/check_settings_usage_contract.mjs",
    "test:console-nav-pruning-contract": "node scripts/check_console_nav_pruning_contract.mjs",
    "test:settings-profile-tab-contract": "node scripts/check_settings_profile_tab_contract.mjs",
    "test:metrics-console-contract": "node scripts/check_metrics_console_contract.mjs",
    "test:publ-iframe-recipient-contract": "node scripts/check_publ_iframe_recipient_contract.mjs",
    "audit:console-navigation-literals": "node scripts/audit_console_navigation_literals.mjs",
    "test:console-embed-navigation-contract": "vitest run --config vitest.config.mjs src/server/__tests__/consoleNavigation.test.js src/server/__tests__/publClientRouting.test.js src/server/__tests__/publClientActorUi.test.js src/server/__tests__/consoleNavigationAudit.test.js && npm run audit:console-navigation-literals",
    "build": "next build",
    "db:migration:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migration:check": "drizzle-kit check --config=drizzle.config.js",
    "db:migration:apply": "node -e \"if (!process.env.DATABASE_MIGRATION_URL && !process.env.DATABASE_URL) throw new Error('DATABASE_MIGRATION_URL or DATABASE_URL is required.')\" && drizzle-kit migrate --config=drizzle.config.js",
    "db:migration:verify": "node scripts/verify_migrations.js",
    "harness:run": "python3 scripts/execute.py",
    "harness:test": "python3 -m unittest scripts/test_execute.py",
    "harness:review": "codex review --uncommitted \"Review changes against AGENTS.md, docs/ARCHITECTURE.md, docs/ADR.md, docs/UI_GUIDE.md, and docs/HARNESS.md. Prioritize bugs, regressions, architecture drift, missing verification, and harness state issues.\"",
    "start": "next start -H 0.0.0.0",
    "worker": "node scripts/worker.js"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@clerk/nextjs": "^7.4.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "chrono-node": "^2.9.1",
    "drizzle-orm": "^0.45.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^6.0.2",
    "recharts": "^3.9.1",
    "sortablejs": "^1.15.7",
    "sugar-date": "^2.0.6",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
